[
  {"bg": "hallway", "show": [], "narration": "[다음 날. 선생님이 명단을 들고 한 명씩 찾아간다]"},
  {"label": "visit_menu", "if": ["met_seoyeon", "met_dahyeon", "met_yuna", "met_jiyu", "met_hayun", "met_eunchae"], "goto": "evening"},
  {"choice": [{"text": "서연 — 도서관 자습실", "goto": "visit_seoyeon", "if": ["!met_seoyeon"]}, {"text": "다현 — 운동장 스탠드", "goto": "visit_dahyeon", "if": ["!met_dahyeon"]}, {"text": "유나 — 복도", "goto": "visit_yuna", "if": ["!met_yuna"]}, {"text": "지유 — 빈 교실, 하교 후", "goto": "visit_jiyu", "if": ["!met_jiyu"]}, {"text": "하윤 — 1학년 3반, 창가 맨 뒷자리", "goto": "visit_hayun", "if": ["!met_hayun"]}, {"text": "은채 — 학교 뒤편 화단", "goto": "visit_eunchae", "if": ["!met_eunchae"]}]},
  {"label": "visit_seoyeon", "set": {"met_seoyeon": true}, "bg": "library", "show": [], "narration": "[도서관 자습실]"},
  {"speaker": "선생님", "text": "서연이 맞지? 쉼표부 맡게 된 선생님이야."},
  {"speaker": "서연", "face": "default", "text": "안녕하세요. *(펜을 내려놓지 않는다)* 죄송한데 저 그 동아리 안 나가도 된다고 들었어요."},
  {"speaker": "선생님", "text": "안 나와도 돼. 그냥 인사하러 왔어."},
  {"speaker": "서연", "text": "그럼 인사는 됐네요. 모의고사가 2주 남아서요."},
  {"goto": "visit_menu"},
  {"label": "visit_dahyeon", "set": {"met_dahyeon": true}, "bg": "field", "show": [], "narration": "[운동장 스탠드]"},
  {"show": ["dahyeon"], "narration": "(트랙 위에서 육상부가 뛰고 있다. 다현은 맨 위 칸에 혼자 앉아 있다. 다리에 보조기)"},
  {"speaker": "다현", "face": "default", "text": "육상부 코치님이 보내셨어요? 아니면 상담 선생님?"},
  {"speaker": "선생님", "text": "둘 다 아니야. 동아리 담당."},
  {"speaker": "다현", "face": "smile", "text": "아, 그 동아리. *(웃는다)* 문제 있는 애들 모아놓은 데요."},
  {"speaker": "다현", "face": "default", "text": "전 여기 있는 게 좋아요. 뛰는 거 보는 거."},
  {"goto": "visit_menu"},
  {"label": "visit_yuna", "set": {"met_yuna": true}, "bg": "hallway", "show": [], "narration": "[복도]"},
  {"speaker": "유나", "face": "smile", "text": "와, 새로 오신 선생님이죠? 진짜 젊으시다! 몇 살이세요? 여자친구 있어요? 아님 남자친구?"},
  {"speaker": "선생님", "text": "동아리 얘기를 하러—"},
  {"speaker": "유나", "face": "smile", "text": "아 그거요? 갈게요 갈게요! *(친구들에게 손을 흔들며 멀어진다)* 다음에요, 선생님!"},
  {"speaker": "선생님", "aside": "독백", "show": [], "text": "저 애가 왜 이 명단에 있는지, 겉으로는 하나도 알 수 없었다."},
  {"goto": "visit_menu"},
  {"label": "visit_jiyu", "set": {"met_jiyu": true}, "bg": "classroom_night", "show": [], "narration": "[빈 교실, 하교 후]"},
  {"narration": "(해가 다 졌는데 교실에 불이 켜져 있다)"},
  {"speaker": "선생님", "text": "지유야, 아직 안 갔어?"},
  {"speaker": "지유", "face": "default", "text": "숙제하고 가려고요."},
  {"speaker": "선생님", "text": "책상에 아무것도 없는데."},
  {"speaker": "지유", "face": "sad", "text": "*(잠시 침묵)* …이제 하려고요. 신경 쓰지 마세요."},
  {"goto": "visit_menu"},
  {"label": "visit_hayun", "set": {"met_hayun": true}, "bg": "classroom", "show": [], "narration": "[1학년 3반, 창가 맨 뒷자리]"},
  {"narration": "(선생님이 반에 들어가 이름을 부르지만, 아무도 대답하지 않는다. 몇 번 더 부르자 구석에서 작게 손이 올라간다)"},
  {"speaker": "선생님", "text": "아, 거기 있었구나. 미안, 못 봤어."},
  {"speaker": "하윤", "face": "sad", "text": "*(고개를 숙인 채)* …괜찮아요. 다들 그래요."},
  {"goto": "visit_menu"},
  {"label": "visit_eunchae", "set": {"met_eunchae": true}, "bg": "garden", "show": [], "narration": "[학교 뒤편 화단]"},
  {"show": ["eunchae"], "narration": "(은채가 시든 화분에 물을 주고 있다. 낡은 노란 머리끈으로 머리를 묶었다)"},
  {"speaker": "선생님", "text": "그 화분, 은채 거야?"},
  {"speaker": "은채", "face": "default", "text": "아뇨. 친구 거예요."},
  {"speaker": "선생님", "text": "그 친구는?"},
  {"speaker": "은채", "text": "*(물뿌리개를 내려놓는다)* 동아리 얘기면 안 갈게요. 거기 가면 다들 무슨 일 있었냐고 물어보잖아요."},
  {"speaker": "선생님", "text": "안 물어볼게."},
  {"speaker": "은채", "face": "sad", "text": "…다들 처음엔 그렇게 말해요."},
  {"goto": "visit_menu"},
  {"label": "evening", "bg": "club_room", "show": [], "narration": "[그날 저녁 — 부실]"},
  {"narration": "(선생님은 부실 문에 종이 한 장을 붙인다)"},
